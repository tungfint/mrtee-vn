generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MONITOR
  STUDENT
}

enum TeamCategory {
  HSG_TIN
  FTC
  AI
}

enum ContentFormat {
  MARKDOWN
  HTML
}

enum MemoryPostType {
  CLASS_INTRO
  CLASS_STORY
  STUDENT_YEARBOOK
  TEAM_STORY
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  LINK
  FILE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)

  classId   String?
  classroom Class?  @relation("ClassStudents", fields: [classId], references: [id], onDelete: SetNull)

  monitoredClass Class?          @relation("ClassMonitor")
  monitoredTeams Team[]          @relation("TeamMonitor")
  profile        StudentProfile?
  posts          Post[]          @relation("PostAuthor")
  memoryPosts    MemoryPost[]    @relation("MemoryPostAuthor")
  accounts       Account[]
  sessions       Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId])
}

model Class {
  id                      String  @id @default(cuid())
  name                    String  @unique
  slug                    String  @unique
  slogan                  String?
  coverImage              String?
  coverImageCrop          String?
  cardBackgroundImage     String?
  cardBackgroundImageCrop String?
  introduction            String? @db.Text
  achievements            String? @db.Text
  externalMediaUrl        String?

  monitorId   String?      @unique
  monitor     User?        @relation("ClassMonitor", fields: [monitorId], references: [id], onDelete: SetNull)
  students    User[]       @relation("ClassStudents")
  memoryPosts MemoryPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  avatar               String?
  photoWithTeacher     String?
  customPhoto1         String?
  customPhoto2         String?
  coverImage           String?
  cardBackgroundImage  String?
  avatarCrop           String?
  photoWithTeacherCrop String?
  customPhoto1Crop     String?
  customPhoto2Crop     String?
  coverImageCrop       String?

  fullName         String
  nickname         String?
  dob              DateTime? @db.Date
  school           String?
  university       String?
  postGraduateWork String?
  hobbies          String?   @db.Text
  futureGoal       String?   @db.Text
  yearbookMessage  String?   @db.Text

  teamMemberships TeamMember[]
  memoryPosts     MemoryPost[]
  yearRecords     StudentYearRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id                      String        @id @default(cuid())
  category                TeamCategory
  year                    Int
  description             String?       @db.Text
  achievements            String?       @db.Text
  introContent            String?       @db.Text
  introFormat             ContentFormat @default(MARKDOWN)
  coverImage              String?
  coverImageCrop          String?
  cardBackgroundImage     String?
  cardBackgroundImageCrop String?
  backgroundImage         String?
  backgroundImageCrop     String?
  galleryImages           String[]      @default([])

  monitorId   String?
  monitor     User?        @relation("TeamMonitor", fields: [monitorId], references: [id], onDelete: SetNull)
  members     TeamMember[]
  memoryPosts MemoryPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, year])
  @@index([category, year])
}

model StudentYearRecord {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  year             Int
  fullName         String
  className        String?
  school           String?
  email            String?
  nickname         String?
  dob              DateTime? @db.Date
  avatar           String?
  photoWithTeacher String?
  customPhoto1     String?
  customPhoto2     String?
  coverImage       String?
  university       String?
  postGraduateWork String?
  futureGoal       String?   @db.Text
  shortMessage     String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentProfileId, year])
  @@index([year])
}

model TeamMember {
  id               String  @id @default(cuid())
  teamId           String
  studentProfileId String
  role             String?

  team           Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teamId, studentProfileId])
  @@index([studentProfileId])
}

model Post {
  id                  String        @id @default(cuid())
  title               String
  slug                String        @unique
  excerpt             String?
  coverImage          String?
  coverImageCrop      String?
  backgroundImage     String?
  backgroundImageCrop String?
  content             String        @db.Text
  contentFormat       ContentFormat @default(MARKDOWN)
  publishedAt         DateTime?

  authorId String?
  author   User?   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
}

model MemoryPost {
  id                  String         @id @default(cuid())
  title               String
  slug                String?        @unique
  type                MemoryPostType
  excerpt             String?
  coverImage          String?
  coverImageCrop      String?
  backgroundImage     String?
  backgroundImageCrop String?
  content             String         @db.Text
  contentFormat       ContentFormat  @default(MARKDOWN)
  publishedAt         DateTime?

  authorId String?
  author   User?   @relation("MemoryPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  studentProfileId String?
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  media MediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([classId, type])
  @@index([studentProfileId, type])
  @@index([teamId, type])
}

model MediaAsset {
  id        String    @id @default(cuid())
  type      MediaType
  url       String
  title     String?
  alt       String?
  caption   String?
  sortOrder Int       @default(0)

  memoryPostId String?
  memoryPost   MemoryPost? @relation(fields: [memoryPostId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memoryPostId, sortOrder])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
